{
  "name": "coiniko",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node prisma-generate.js && prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,ts,tsx,json}\"",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "analyze": "ANALYZE=true next build",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "type-check": "tsc --noEmit",
    "vercel-build": "node prisma-generate.js && prisma generate && next build",
    "fix-auth": "node fix-auth.js",
    "fix-oauth": "node fix-google-oauth.js",
    "create-oauth": "node create-oauth-client.js",
    "update-oauth": "node update-oauth.js",
    "fix-db": "node fix-database.js",
    "db:reset": "npx prisma migrate reset && npx prisma db push",
    "auth-diagnostic": "node auth-diagnostic.js",
    "test-auth": "node test-auth.js",
    "reset-db": "node -e \"require('./lib/db').resetPrisma().then(() => console.log('Database reset successful')).catch(e => console.error('Reset failed:', e))\"",
    "clean-all": "rm -rf .next node_modules/.cache node_modules/.prisma && npm run db:generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.1",
    "@hookform/resolvers": "^3.3.4",
    "@prisma/client": "^6.7.0",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-toast": "^1.2.13",
    "@tanstack/react-table": "^8.20.6",
    "@types/pg": "^8.10.9",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "dotenv": "^16.5.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.1",
    "next-auth": "^4.24.11",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.1",
    "pg": "^8.11.3",
    "postgres": "^3.4.7",
    "prisma": "^6.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.51.0",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.0",
    "sharp": "^0.33.2",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^2.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
