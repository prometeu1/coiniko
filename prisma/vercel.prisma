generator client {
  provider = "prisma-client-js"
  previewFeatures = []
  output = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?    @map("email_verified")
  image         String?
  accounts      Account[]
  portfolios    portfolios[]
  rankings      rankings?
  sessions      Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model portfolios {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  user_id      String
  balance      Decimal?       @default(100000) @db.Decimal
  holdings     holdings[]
  user         User           @relation(fields: [user_id], references: [id])
  transactions transactions[]
}

model holdings {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portfolio_id      String     @db.Uuid
  crypto_id         String
  crypto_name       String?
  crypto_symbol     String?
  amount            Decimal    @db.Decimal
  average_buy_price Decimal    @db.Decimal
  portfolio         portfolios @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)

  @@unique([portfolio_id, crypto_id])
}

model transactions {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portfolio_id         String     @db.Uuid
  crypto_id            String
  crypto_name          String?
  crypto_symbol        String?
  amount               Decimal    @db.Decimal
  price_at_transaction Decimal    @db.Decimal
  transaction_type     String
  timestamp            DateTime   @default(now()) @db.Timestamptz(6)
  portfolio            portfolios @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)
}

model rankings {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @unique
  total_value  Decimal  @db.Decimal
  rank         Int
  last_updated DateTime @default(now()) @db.Timestamptz(6)
  user         User     @relation(fields: [user_id], references: [id])
} 