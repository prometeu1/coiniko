{
  "rewrites": [{ "source": "/(.*)", "destination": "/" }],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "buildCommand": "npm run vercel-build"
      }
    }
  ],
  "env": {
    "VERCEL_BUILD": "true"
  },
  "build": {
    "env": {
      "PRISMA_GENERATE": "true"
    }
  }
}